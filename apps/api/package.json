{
  "name": "@stockpilot/api",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/db/seed/run.ts",
    "test": "vitest run",
    "eval": "tsx --env-file-if-exists=../../.env ../../evals/runner.ts",
    "smoke": "tsx --env-file-if-exists=../../.env src/smoke.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@stockpilot/shared": "3.0.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.3",
    "@fastify/static": "10.1.6",
    "@google/genai": "2.28.0",
    "fastify": "5.12.5",
    "highs": "1.15.3",
    "node-cron": "4.6.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
