# StockPilot AI configuration (Solution Design §D7.5). Copy to .env — never commit .env.
# Everything works without the optional keys: agents run as labelled rule-based pipelines and emails stay in the outbox.

PORT=8787
HOST=127.0.0.1                  # 0.0.0.0 when hosted (e.g. Render)
DATABASE_PATH=./data/stockpilot.db
SEED_IF_EMPTY=true              # load the starting restaurant data on first start with an empty database
TZ=America/Los_Angeles

# Required to start the API: random, at least 32 characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Google Gemini (optional; Google AI Studio key, Free Tier, billing disabled). Empty → deterministic mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite  # separate free-tier daily quota; used when the primary is out or slow
GEMINI_API_STYLE=generate_content   # or interactions
GEMINI_MAX_RPM=10
GEMINI_DAILY_BUDGET=250
AI_LOG_PAYLOADS=true

# The morning-run time is a restaurant setting (onboarding / Settings, default 06:00 local), not an env variable.
SCHEDULER_ENABLED=true          # false: no automatic morning run / nightly fit (use "Run morning now")
WORKER_ENABLED=true

# Demo mode: reset + time-travel controls, and every email to a seeded *.example address goes to the demo inbox below.
DEMO_MODE=true

# Brevo transactional email (optional; free plan, no credit card). Empty → outbox entries are `not_configured`.
BREVO_API_KEY=                  # Brevo → SMTP & API → API keys (transactional-email permission is enough)
BREVO_SENDER_EMAIL=             # a sender address verified in Brevo (Senders, domains & dedicated IPs)
BREVO_SENDER_NAME=StockPilot AI
# EMAIL_FROM / EMAIL_FROM_NAME are older names for the sender and are still read if BREVO_SENDER_* are empty.
SUPPLIER_EMAIL_OVERRIDE=        # demo inbox for supplier/briefing emails (defaults to EMAIL_FROM)

# Base URL used in supplier portal links. Dev (Vite): http://localhost:5173 · production build: http://localhost:8787
APP_BASE_URL=http://localhost:5173

TELEGRAM_BOT_TOKEN=             # P1, not implemented

# Docker (local only; read by docker-compose.yml, ignored by `npm run dev` and by Render).
# Inside containers HOST, PORT, DATABASE_PATH and APP_BASE_URL are set by docker-compose.yml, not by the values above.
# DOCKER_WEB_PORT=8080            # app at http://localhost:8080
# DOCKER_API_PORT=8787            # API published on 127.0.0.1 only (change it if `npm run dev` is running)
# DOCKER_DEV_WEB_PORT=5173        # hot-reload stack (docker-compose.dev.yml)
# DOCKER_APP_BASE_URL=http://localhost:8080
