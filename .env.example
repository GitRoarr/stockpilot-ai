# StockPilot AI configuration (Solution Design §D7.5). Copy to .env — never commit .env.
# Everything works without the optional keys: agents run as labelled rule-based pipelines and emails stay in the outbox.

PORT=8787
DATABASE_PATH=./data/stockpilot.db
TZ=America/Los_Angeles

# Required to start the API: random, at least 32 characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Google Gemini (optional; Google AI Studio key, Free Tier, billing disabled). Empty → deterministic mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_API_STYLE=interactions   # or generate_content
GEMINI_MAX_RPM=10
GEMINI_DAILY_BUDGET=250
AI_LOG_PAYLOADS=true

# The morning-run time is a restaurant setting (onboarding / Settings, default 06:00 local), not an env variable.
SCHEDULER_ENABLED=true          # false: no automatic morning run / nightly fit (use "Run morning now")
WORKER_ENABLED=true

# Demo mode: reset + time-travel controls, and every email to a seeded *.example address goes to the demo inbox below.
DEMO_MODE=true

# Brevo transactional email (optional; free plan, no credit card). Empty → outbox entries are `not_configured`.
BREVO_API_KEY=
EMAIL_FROM=                     # sender address verified in Brevo
EMAIL_FROM_NAME=StockPilot AI
SUPPLIER_EMAIL_OVERRIDE=        # demo inbox for supplier/briefing emails (defaults to EMAIL_FROM)

# Base URL used in supplier portal links. Dev (Vite): http://localhost:5173 · production build: http://localhost:8787
APP_BASE_URL=http://localhost:5173

TELEGRAM_BOT_TOKEN=             # P1, not implemented
