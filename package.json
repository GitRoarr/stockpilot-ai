{
  "name": "stockpilot",
  "private": true,
  "version": "3.0.0",
  "description": "StockPilot AI \u2014 your AI purchasing team for restaurants",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "seed": "npm run seed -w backend",
    "test": "npm run test -w backend",
    "eval": "npm run eval -w backend --",
    "smoke": "npm run smoke -w backend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "concurrently": "10.0.6",
    "typescript": "7.0.2"
  }
}
